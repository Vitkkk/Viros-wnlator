<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viros_bg"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biblioteca"
                android:textColor="@color/viros_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/VirosLibraryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jogos de PC"
                android:textColor="@color/viros_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/VirosRefreshButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:text="Atualizar"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/VirosAdvancedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="Avançado"
            android:textAllCaps="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/VirosGameGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="9dp" />

        <LinearLayout
            android:id="@+id/VirosSetupPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Escolha sua pasta de jogos"
                android:textColor="@color/viros_text"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Selecione uma pasta local que contenha seus jogos Windows. O Viros encontrará os executáveis e montará sua biblioteca."
                android:textColor="@color/viros_text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/VirosSelectFolderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Selecionar pasta"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/VirosProgressPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B30A1220"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/VirosProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Encontrando jogos…"
                android:textColor="@color/viros_text"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
